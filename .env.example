# Environment
NODE_ENV=development

# Application
APP_NAME=nest-basic-prisma
PORT=3000

# Cookie Domain (for setting cookies in browser, e.g., refresh token)
COOKIE_DOMAIN=localhost
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_MAX_AGE=604800000 # 7 days in milliseconds

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_SCHEMA=public

# Database URL (constructed from above variables)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"

# Docker Database Config
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}

# Docker Ports
DEV_DB_PORT=5432
PROD_DB_PORT=5554

# Jobs
TZ=Asia/Ho_Chi_Minh
# every 2 minutes
EXAMPLE_CRON=*/2 * * * *

# Health Check Configuration
# Set to 'true' to enable detailed health endpoints in production
# Default: false (only /health/live is available in production)
HEALTH_ENDPOINTS_ENABLED=false

# Security & Monitoring
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# File Upload Configuration
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# Asset Storage Configuration
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
STORAGE_DRIVER=local
STORAGE_ROOT_DIR=./storage
STORAGE_PUBLIC_DIR_NAME=public
STORAGE_PRIVATE_DIR_NAME=private
STORAGE_TEMP_DIR_NAME=temp
ASSET_CDN_URL="http://localhost:3000/cdn"
ASSET_MAX_FILE_SIZE=10485760
ASSET_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,video/mp4,video/quicktime,audio/mpeg,audio/wav,application/pdf

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=5

# Rate Limiting (Optional)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Security
BCRYPT_ROUNDS=12

# Monitoring (Optional)
PROMETHEUS_ENABLED=false
METRICS_PORT=9090

# OAuth2 Configuration (Optional)
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here
CALLBACK_URL=
SCOPES=email profile openid

# external api
BANK_API_VN=
PROVINCES_API_VN=
QR_API_VN=
TAX_CODE_API_VN=

# Client
FRONTEND_URL=http://localhost:3001